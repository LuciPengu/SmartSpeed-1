entrypoint = "main.py"
modules = ["python-3.11", "postgresql-16", "nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["libGL", "libGLU", "libxcrypt", "xorg.libX11", "xorg.libxcb"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["bash", "-c", "BACKEND_PORT=5000 python -m uvicorn backend.main:app --host 0.0.0.0 --port 5000"]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd client && npm install && npm run build"]

[agent]
expertMode = true
integrations = ["stripe:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Hitsmart App"

[[workflows.workflow]]
name = "Hitsmart App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BACKEND_PORT=5001 python -m uvicorn backend.main:app --host 0.0.0.0 --port 5001 --reload & sleep 2 && cd client && npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
STRIPE_WEBHOOK_SECRET = "whsec_TzGpcWVImoHMqyxjr5QQ5x8w8cyvyT86"
